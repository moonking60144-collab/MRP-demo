// Archive metadata is separate from the production client and database.
// Snapshot table imports are not verified merely by registering a seed.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/archive-client"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://demo_disabled@127.0.0.1:1/demo_disabled_archive"
  schemas  = ["archive_meta", "archive_data"]
}

model ArchiveSource {
  sha256          String   @id @db.Char(64)
  sourceInstance  String   @map("source_instance")
  seedFileName    String   @map("seed_file_name")
  sourceFileName  String   @map("source_file_name")
  schemaGeneration String @map("schema_generation")
  sizeBytes       BigInt   @map("size_bytes")
  manifest        Json
  hashVerifiedAt  DateTime @map("hash_verified_at") @db.Timestamptz()
  registeredAt    DateTime @default(now()) @map("registered_at") @db.Timestamptz()
  runs            ArchiveSourceRun[]
  attempts        ArchiveImportAttempt[]

  @@unique([sha256, sourceInstance])
  @@map("archive_sources")
  @@schema("archive_meta")
}

model ArchiveSourceRun {
  sourceSha256 String @map("source_sha256") @db.Char(64)
  sourceRunId  Int    @map("source_run_id")
  sourceInstance String @map("source_instance")
  source       ArchiveSource @relation(fields: [sourceSha256, sourceInstance], references: [sha256, sourceInstance], onDelete: Restrict)
  coverage     ArchiveRunCoverage[]
  attempts     ArchiveImportAttempt[]

  @@id([sourceSha256, sourceRunId])
  @@unique([sourceSha256, sourceRunId, sourceInstance])
  @@index([sourceRunId])
  @@map("archive_source_runs")
  @@schema("archive_meta")
}

model ArchiveImportAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  sourceSha256 String   @map("source_sha256") @db.Char(64)
  sourceRunId  Int      @map("source_run_id")
  status       String   @default("pending")
  startedAt    DateTime @default(now()) @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()
  errorCode    String?  @map("error_code")
  importerVersion String @map("importer_version")
  source       ArchiveSource @relation(fields: [sourceSha256], references: [sha256], onDelete: Restrict)
  sourceRun    ArchiveSourceRun @relation(fields: [sourceSha256, sourceRunId], references: [sourceSha256, sourceRunId], onDelete: Restrict)
  runs         ArchiveRunCoverage[]

  @@unique([id, sourceSha256, sourceRunId])
  @@map("archive_import_attempts")
  @@schema("archive_meta")
}

model ArchiveRunCoverage {
  id            String   @id @default(uuid()) @db.Uuid
  sourceInstance String  @map("source_instance")
  sourceRunId   Int      @map("source_run_id")
  sourceSha256  String   @map("source_sha256") @db.Char(64)
  attemptId     String   @map("attempt_id") @db.Uuid
  versionCode   String   @map("version_code")
  runDate       DateTime @map("run_date") @db.Date
  sourceStatus  String   @map("source_status")
  orderDemandContractVersion String? @map("order_demand_contract_version")
  sourceRun     Json     @map("source_run")
  status        String   @default("pending")
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz()
  source        ArchiveSourceRun @relation(fields: [sourceSha256, sourceRunId, sourceInstance], references: [sourceSha256, sourceRunId, sourceInstance], onDelete: Restrict)
  attempt       ArchiveImportAttempt @relation(fields: [attemptId, sourceSha256, sourceRunId], references: [id, sourceSha256, sourceRunId], onDelete: Restrict)
  tables        ArchiveTableVerification[]
  snapshotMrpRun SnapshotMrpRun[]
  snapshotStagingPartVersion SnapshotStagingPartVersion[]
  snapshotStagingInventory SnapshotStagingInventory[]
  snapshotStagingInventoryLot SnapshotStagingInventoryLot[]
  snapshotStagingOrder SnapshotStagingOrder[]
  snapshotStagingForecast SnapshotStagingForecast[]
  snapshotStagingWorkOrder SnapshotStagingWorkOrder[]
  snapshotStagingWorkOrderBom SnapshotStagingWorkOrderBom[]
  snapshotStagingWorkOrderMaterialMovement SnapshotStagingWorkOrderMaterialMovement[]
  snapshotStagingProductionPlan SnapshotStagingProductionPlan[]
  snapshotStagingPurchaseOrder SnapshotStagingPurchaseOrder[]
  snapshotFgMonthly SnapshotFgMonthly[]
  snapshotFgMonthlyPeriod SnapshotFgMonthlyPeriod[]
  snapshotFgPlanSuggestion SnapshotFgPlanSuggestion[]
  snapshotComponentWeekly SnapshotComponentWeekly[]
  snapshotComponentWeeklyPeriod SnapshotComponentWeeklyPeriod[]
  snapshotSalesMeeting SnapshotSalesMeeting[]
  snapshotSalesMeetingPeriod SnapshotSalesMeetingPeriod[]

  // One selected source per Run; importing an overlapping dump cannot replace it.
  @@unique([sourceInstance, sourceRunId])
  @@index([status, runDate])
  @@map("archive_run_coverage")
  @@schema("archive_meta")
}

model ArchiveTableVerification {
  archiveRunId String @map("archive_run_id") @db.Uuid
  tableName    String @map("table_name")
  status       String @default("pending")
  sourcePresent Boolean @map("source_present")
  sourceColumns Json @map("source_columns")
  missingColumns Json @map("missing_columns")
  sourceRows   BigInt? @map("source_rows")
  archiveRows  BigInt? @map("archive_rows")
  sourceDigest String? @map("source_digest") @db.Char(64)
  archiveDigest String? @map("archive_digest") @db.Char(64)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz()
  run          ArchiveRunCoverage @relation(fields: [archiveRunId], references: [id], onDelete: Restrict)

  @@id([archiveRunId, tableName])
  @@map("archive_table_verification")
  @@schema("archive_meta")
}

// Business columns are nullable; an absent historical field is not a synthesized zero.
model SnapshotMrpRun {
  archiveRunId String @map("archive_run_id") @db.Uuid
