  createdAt DateTime? @map("created_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  createdBy String? @map("created_by")
  syncCounts Json? @map("sync_counts")
  stepStatus Json? @map("step_status")
  stepTiming Json? @map("step_timing")
  errorMessage String? @map("error_message")
  logs Json? @map("logs")
  run ArchiveRunCoverage @relation(fields: [archiveRunId], references: [id], onDelete: Restrict)

  @@id([archiveRunId, id])
  @@map("public_mrp_run")
  @@schema("archive_data")
}

