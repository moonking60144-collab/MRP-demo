{
  "name": "mrp-demo",
  "version": "2.1.37",
  "private": true,
  "scripts": {
    "prebuild": "npm run db:generate && npm run archive:generate",
    "dev": "node scripts/next-command.mjs dev",
    "build": "node scripts/next-command.mjs build",
    "start": "node scripts/start-demo.mjs",
    "start:postgres": "node scripts/start-postgres-demo.mjs",
    "start:postgres:local": "node scripts/start-postgres-demo.mjs --local",
    "lint": "eslint .",
    "pretest": "npm run db:generate && npm run archive:generate",
    "test": "node scripts/test-demo.mjs",
    "test:postgres": "npm run db:generate && node scripts/test-postgres.mjs",
    "test:postgres:local": "npm run db:generate && node scripts/test-postgres.mjs --local",
    "test:postgres:web": "npm run db:generate && node scripts/test-postgres-web.mjs",
    "test:smoke": "node scripts/smoke-demo.mjs",
    "test:postgres:smoke": "node scripts/smoke-postgres-demo.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "db:generate": "prisma generate",
    "archive:generate": "prisma generate --schema prisma/archive.prisma",
    "archive:validate": "prisma validate --schema prisma/archive.prisma"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@prisma/client": "^6.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "lucide-react": "^1.24.0",
    "next": "^15.0.0",
    "next-intl": "^3.0.0",
    "nodemailer": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.0.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
